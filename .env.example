# ─────────────────────────────────────────────────────────────────────
# BetX platform configuration. Copy to backend/.env (and frontend/admin
# .env files for VITE_* values). NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development
PORT=4000
APP_NAME=BetX
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Number of reverse-proxy hops to trust for client IPs (1 behind nginx/ALB)
TRUST_PROXY=0
LOG_LEVEL=info
# Run background jobs (catalogue sync, settlement, reconciliation) on this instance
JOBS_ENABLED=true

# ── MySQL ──
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=betx
DATABASE_PASSWORD=change-me
DATABASE_NAME=betx
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# ── Auth / crypto (generate with: openssl rand -hex 32) ──
JWT_ACCESS_SECRET=
JWT_ADMIN_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REFRESH_TOKEN_TTL_HOURS=12
# 32-byte hex key for encrypting 2FA secrets at rest
ENCRYPTION_KEY=
# true in production (HTTPS only)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Betfair ──
# mock = simulated exchange for development/testing (refused when NODE_ENV=production)
# live = real Betfair Exchange API-NG + Stream API
BETFAIR_MODE=mock
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Client certificate for non-interactive login (and key, if not in the same PEM)
BETFAIR_CERT_PATH=
BETFAIR_KEY_PATH=
BETFAIR_API_URL=https://api.betfair.com/exchange
BETFAIR_IDENTITY_URL=https://identitysso-cert.betfair.com/api
BETFAIR_STREAM_HOST=stream-api.betfair.com
# true = Exchange Stream API; false = listMarketBook polling fallback
BETFAIR_STREAMING=true
BETFAIR_TIMEOUT_MS=8000
# Betfair event type IDs to sync (Cricket, Football, Tennis, …)
BETFAIR_EVENT_TYPE_IDS=4,1,2,7522,7511,7524,998917,5,3,6,26420387,7,27454571
# Only enable once your Betfair app key/agreement permits order placement
BETFAIR_PLACE_ORDERS=false
ALLOW_MOCK_IN_PRODUCTION=false

# ── Trading / compliance ──
COMMISSION_RATE=0.02
MIN_STAKE=10
MIN_AGE=18
TERMS_VERSION=1.0
DEFAULT_CURRENCY=INR
# Header set by your CDN/load balancer with the client's ISO country code
GEO_COUNTRY_HEADER=cf-ipcountry
# Comma-separated ISO codes. Leave ALLOWED empty to allow all except BLOCKED.
GEO_BLOCKED_COUNTRIES=
GEO_ALLOWED_COUNTRIES=

# ── Payments ── (mock = instant, dev only; manual = admin-confirmed bank transfer)
PAYMENT_PROVIDER=mock

# ── Email ── (without SMTP in development, mail is captured at GET /api/dev/mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# ── Seed (scripts/seed.ts) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEV_DATA=false

# ── Frontend / Admin (Vite) ──
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000/ws
VITE_BRAND_NAME=BetX
